# Copy to ".env.prod" and fill in real values. NEVER commit .env.prod.
# (deploy/.env.prod is gitignored.)

# --- Public domains (A records must point at this host's public IP) ----------
# Two subdomains: one for the API/auth server, one for the SPA.
API_DOMAIN=api.example.com
APP_DOMAIN=app.example.com

# --- PostgreSQL --------------------------------------------------------------
POSTGRES_DB=PharmacySystem
POSTGRES_USER=pharmacy
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password

# --- OpenIddict signing/encryption certificate -------------------------------
# Generate deploy/certs/openiddict.pfx (see README) and put its password here.
CERT_PASSPHRASE=CHANGE_ME_cert_password

# --- ABP string/data-protection encryption -----------------------------------
# Keep this STABLE forever. Changing it makes previously-encrypted data
# unreadable. Use a long random value (>= 32 chars).
STRING_ENCRYPTION_PASSPHRASE=CHANGE_ME_long_random_min_32_chars

# --- Demo data ---------------------------------------------------------------
# false = production (only admin/roles seeded). true = also seed the 63-medicine
# demo catalogue + sales/purchases (useful for a public demo).
SEED_DEMO_DATA=false
